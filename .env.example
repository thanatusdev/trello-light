# Copy to .env and adjust. Hosts are `localhost` for running tools on the host;
# docker-compose overrides them to the service names inside containers.

APP_ENV=local

POSTGRES_USER=kanban
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kanban
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
TEST_POSTGRES_DB=kanban_test

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

API_PORT=8000
# Host port for the web app (nginx serving the SPA and proxying /api).
FRONTEND_PORT=8080

# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-secret-of-32-plus-chars
# Optional; defaults shown.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Optional; overrides the minutes above when set (the e2e stack uses 5).
# ACCESS_TOKEN_EXPIRE_SECONDS=
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Optional; default shown. One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Optional; default shown. Timeout for the database and Redis probes in /api/v1/health.
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# Rate limits (slowapi syntax, e.g. "5/minute"); defaults shown. Storage defaults to Redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute

# Hour (UTC, 0-23) of the daily "tasks due soon" email digest.
DUE_SOON_HOUR_UTC=8

# Demo data, created when the api container starts. Demo logins (all share the password):
#   alice@example.com / bob@example.com / carol@example.com
# Never enable this in production.
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=Demo1234!
